{
  "name": "pocket-chess",
  "version": "1.0.0",
  "description": "Small boards, sharp tactics. A minimalist chess puzzle trainer with a daily puzzle, motif drills and spaced repetition. No ads, works offline.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test \"test/*.test.mjs\"",
    "build:puzzles": "node tools/build-puzzles.mjs",
    "build:puzzles:quick": "node tools/build-puzzles.mjs --max-rows=200000"
  },
  "keywords": ["chess", "puzzles", "tactics", "pwa", "offline"],
  "engines": {
    "node": ">=22.15"
  }
}
